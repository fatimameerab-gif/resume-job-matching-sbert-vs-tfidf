<mxfile host="app.diagrams.net"><diagram id="p0" name="From literature to research questions"><mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="540" pageHeight="662" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c1" value="From literature to research questions" style="text;html=1;align=center;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="150" y="4" width="240" height="28" as="geometry"/></mxCell>
<mxCell id="c2" value="Literature review&lt;br&gt;(person-job fit, dense vs lexical retrieval, weak labels,&lt;br&gt;robustness, classifier choice)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#444444;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="60" y="40" width="420" height="50" as="geometry"/></mxCell>
<mxCell id="c3" value="Dense encoders are the default, but BM25 / TF-IDF is a strong zero-shot baseline; no controlled resume study" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DCE8F8;strokeColor=#6F93C8;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="10" y="136" width="160" height="92" as="geometry"/></mxCell>
<mxCell id="c4" value="Dense models are fragile to typos and input perturbations; resumes are noisy" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7DDF2;strokeColor=#9A82BE;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="190" y="136" width="160" height="92" as="geometry"/></mxCell>
<mxCell id="c5" value="No classifier family wins everywhere; the layer above embeddings is rarely compared" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#D9B64F;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="370" y="136" width="160" height="92" as="geometry"/></mxCell>
<mxCell id="c6" value="RQ1 Representation&lt;br&gt;encoder vs TF-IDF,&lt;br&gt;frozen vs fine-tuned" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDE3CC;strokeColor=#E0A070;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="10" y="274" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="c7" value="RQ2 Robustness&lt;br&gt;lexical variation and&lt;br&gt;harmless edits" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDE3CC;strokeColor=#E0A070;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="190" y="274" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="c8" value="RQ3 Decision layer&lt;br&gt;classifier vs&lt;br&gt;representation" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDE3CC;strokeColor=#E0A070;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="370" y="274" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="c9" value="Frozen and fine-tuned encoders, unseen categories, full pool" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#444444;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="10" y="390" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="c10" value="ESCO synonyms, typos, sentence order, LLM rewrite, CheckList" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#444444;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="190" y="390" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="c11" value="8 tuned classifiers, complete pipelines, full pool" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#444444;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="370" y="390" width="160" height="70" as="geometry"/></mxCell>
